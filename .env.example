# Copy to .env and fill in. With an EMPTY .env CheckAm runs in sample mode:
# same agents, same SQL, the public parquet files instead of Zetaris, rule-based fallbacks instead of Nemotron.

# Zetaris (local install, JDBC first, REST second)
ZETARIS_ADMIN_EMAIL=
ZETARIS_ADMIN_PASSWORD=
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# NVIDIA Nemotron (build.nvidia.com)
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
NEMOTRON_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety

# Meterless engines (TypeScript services)
WORLD_MODEL_URL=http://127.0.0.1:8790
SCOUT_URL=http://127.0.0.1:8791

# Optional: HMAC key of the Stop Arnaque 237 pseudonyms (private, never committed).
# Lets a real number pasted by a citizen match the codes in the public data.
PSEUDONYM_KEY_FILE=
PSEUDONYM_KEY=

# App
SAMPLE_MODE=
CHECKAM_SECRET=
CHECKAM_JUDGE_EMAIL=
CHECKAM_JUDGE_PASSWORD=
MAX_AGENT_ROUNDS=3
