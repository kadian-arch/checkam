# Copy to .env and fill in. With an EMPTY .env CheckAm runs in sample mode:
# same agents, same SQL, the public parquet files instead of Zetaris, rule-based fallbacks instead of Nemotron.
# Never commit .env. On Render the same names go in the service's Environment page.

# Zetaris (local install, JDBC first, REST second)
ZETARIS_ADMIN_EMAIL=
ZETARIS_ADMIN_PASSWORD=
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_DB=STOP_ARNAQUE

# NVIDIA Nemotron (build.nvidia.com)
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
# One key, or several separated by commas (no spaces): calls are spread across them, each at its own pace
MODEL_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
NEMOTRON_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
# Requests per minute allowed per key, and how many calls may run at once
NVIDIA_RPM=35
NVIDIA_MAX_INFLIGHT=6

# Meterless engines (TypeScript services)
WORLD_MODEL_URL=http://127.0.0.1:8790
WORLD_MODEL_PORT=8790
WORLD_MODEL_FILE=data/world.json
SCOUT_URL=http://127.0.0.1:8791
SCOUT_PORT=8791
# Signs Scout contracts; falls back to CHECKAM_SECRET
SCOUT_SECRET=

# Optional: HMAC key of the Stop Arnaque 237 pseudonyms (private, never committed).
# Lets a real number pasted by a citizen match the codes in the public data. Base64 in PSEUDONYM_KEY, or a file path.
PSEUDONYM_KEY_FILE=
PSEUDONYM_KEY=

# App
SAMPLE_MODE=
# Signs analyst sign-in tokens. Long random value.
CHECKAM_SECRET=
# Ed25519 key that signs public alerts (base64 of 32 random bytes). Never change it once an alert is published.
CHECKAM_SIGNING_KEY=
CHECKAM_JUDGE_EMAIL=
CHECKAM_JUDGE_PASSWORD=
MAX_AGENT_ROUNDS=3
# Public address used in shared links and the Telegram bot (checkam.me in production; leave local on your machine)
CHECKAM_PUBLIC_URL=http://localhost:8000
# Other sites allowed to call the API from a browser, comma-separated (empty: same site only)
CHECKAM_ORIGINS=
# Where the case store, logs and data live (defaults: data/, logs/)
CHECKAM_DATA_DIR=
CHECKAM_DB=
CHECKAM_LOG_DIR=
# Seed the campaign graph from the dataset at start-up
CHECKAM_SEED_ON_START=true
# Look up how old a linked site is in the public domain registry (needs internet)
CHECKAM_LINKCHECK=true

# Telegram bot (create it with @BotFather; the secret is any long random value)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
